{
  "setup": [
    {
      "jsonFile": "needs.json",
      "from": "./slice",
      "call": "configureNeeds"
    }
  ],
  "contentExtensions": [
    {
      "jsonFile": "needs.json",
      "contentKey": "needThresholds",
      "hydratorFrom": "./hydrate",
      "hydratorCall": "hydrateNeedThresholds"
    }
  ],
  "contentSetup": [
    {
      "contentKey": "needThresholds",
      "from": "./lib/thresholds",
      "call": "configureNeedThresholds"
    }
  ]
}

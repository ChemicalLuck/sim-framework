{
  "contentExtensions": [
    {
      "jsonFile": "quests.json",
      "contentKey": "quests",
      "hydratorFrom": "./hydrate",
      "hydratorCall": "hydrateQuests"
    },
    {
      "jsonFile": "quest-templates.json",
      "contentKey": "questTemplates",
      "optional": true,
      "hydratorFrom": "./hydrate",
      "hydratorCall": "hydrateQuestTemplates"
    }
  ],
  "contentSetup": [
    {
      "contentKey": "quests",
      "from": "./initializer",
      "call": "registerInitialQuests"
    },
    {
      "contentKey": "questTemplates",
      "from": "./lib/templates",
      "call": "initQuestTemplates"
    }
  ]
}
